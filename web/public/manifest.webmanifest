{
  "id": "/",
  "name": "MovieSphere — Authorized Movies",
  "short_name": "MovieSphere",
  "description": "Stream and download free, legal movies — public-domain classics and openly licensed films.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#080808",
  "theme_color": "#080808",
  "categories": ["entertainment", "video"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Search", "url": "/search", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My List", "url": "/my-list", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Downloads", "url": "/downloads", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
