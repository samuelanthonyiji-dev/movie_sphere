# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL="postgresql://cinevault:cinevault@localhost:5432/cinevault?schema=public"
# Migrations use a direct (non-transaction-pooled) connection. Locally the same as DATABASE_URL.
DIRECT_URL="postgresql://cinevault:cinevault@localhost:5432/cinevault?schema=public"
# Storage: "local" (default) or "supabase" (needs SUPABASE_URL + SUPABASE_SECRET_KEY)
STORAGE_DRIVER=local
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
# Public origin of the site (used for sitemap, OG tags, password reset links)
PUBLIC_ORIGIN="http://localhost:5173"
# Local object storage directory (posters, backdrops, subtitles, authorized media)
STORAGE_DIR="./storage"
# Max upload sizes
MAX_IMAGE_MB=10
MAX_VIDEO_MB=4096
# Seeded admin account (change immediately in production)
ADMIN_EMAIL="admin@cinevault.local"
ADMIN_PASSWORD="ChangeMe!2026"
# Path to built frontend (served in production)
WEB_DIST="../web/dist"
NODE_ENV=development
